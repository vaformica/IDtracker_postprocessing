<!doctype html><html lang="en"><meta charset="utf-8"><title>BA review — __TITLE__</title>
<style>body{font:15px system-ui;background:#101b25;color:#eaf1f5;margin:24px auto;max-width:1280px}h1{font-size:22px}button,input,select{font:inherit;margin:5px;padding:6px}#stage{position:relative;width:100%;aspect-ratio:1280/920}video,canvas{position:absolute;width:100%;height:100%}#overlay{pointer-events:none}#slider{width:95%}.note{color:#bfd0dc}#status{padding:12px;background:#213342}a{color:#82d7e4}textarea{width:90%;height:60px}</style>
<h1>BA · __TITLE__ · UNREVIEWED</h1>
<p><a href="unified_qc.html">Video disturbances and tracking QC — all review reasons</a></p>
<p class="note">One animal, one arena. Original IDtracker locations; missing intervals are not filled. Trails break at missing endpoints and rejected jumps. Turtling flags are movement-pattern candidates, not confirmed posture.</p>
<div id="stage"><video id="video" src="review_video.mp4" preload="auto" playsinline controls></video><canvas id="overlay" width="1280" height="920"></canvas></div>
<p><button id="play">Play / pause</button><button id="back">−1 frame</button><button id="forward">+1 frame</button><label>Speed <select id="rate"><option>0.25</option><option>0.5</option><option selected>1</option></select></label><label><input id="trails" type="checkbox" checked>300-frame trail</label></p>
<p id="mediaMessage" role="status">Loading video…</p><input id="slider" type="range" min="0" value="0"><p id="status"></p>
<section><h2>Turtling candidates</h2><p id="turtleSummary"></p><label>Jump to candidate bout <select id="bout"><option value="">Choose a bout</option></select></label><canvas id="timeline" width="1000" height="26" style="position:static;width:100%;height:26px"></canvas><p>Red: candidate; green: human-confirmed overturned; gray: tracking unknown. Unmarked time is not confirmed upright.</p></section>
<section id="experimentalPanel" hidden><h2>Experimental turtling rules</h2><p id="experimentalSummary"></p><label><input id="experimentalToggle" type="checkbox" checked>Show experimental candidates</label><p>Purple: added onset or quiet-pause hypothesis. These are unvalidated movement cues, not confirmed posture. Uncheck to compare the original detector.</p></section>
<details><summary>Record an attributed review note</summary><p>Notes are exported separately; they do not change coordinates or approve the automatic bundle.</p><label>Reviewer <input id="reviewer"></label><label>First global frame <input id="first" type="number"></label><label>Last global frame <input id="last" type="number"></label><button id="current">Use current frame</button><textarea id="reason" placeholder="What needs checking, or what you observed"></textarea><br><label>Decision <select id="decision"><option value="note">Note only</option><option value="confirmed_overturned">Confirmed overturned (including quiet pauses)</option><option value="rejected_overturned">Not overturned</option><option value="active_flailing">Active flailing</option><option value="inactive_flailing">Flailing paused / inactive</option><option value="uncertain">Uncertain posture</option></select></label><button id="add">Add note / decision</button><button id="export">Export notes</button><span id="count">0 notes</span></details>
<p><a href="summary.csv">Summary CSV</a> · <a href="frame_data.csv">Frame data</a> · <a href="manifest.json">Provenance</a></p>
<script>
const D=__PAYLOAD__;
const video=document.getElementById('video'), slider=document.getElementById('slider'), ctx=document.getElementById('overlay').getContext('2d');
slider.max=D.frames.length-1;const notes=[];
const cumulative=[];let total=0;D.frames.forEach((f,i)=>{total+=(D.reviewed?D.reviewed.episode_mask[i]:f.turtling_candidate)?1:0;cumulative.push(total/D.fps)});
const experimentalCumulative=[];let experimentalTotal=0;
if(D.experimental){document.getElementById('experimentalPanel').hidden=false;D.experimental.episode_mask.forEach(v=>{experimentalTotal+=v?1:0;experimentalCumulative.push(experimentalTotal/D.fps)});document.getElementById('experimentalSummary').textContent=`Original: ${D.turtling.candidate_seconds.toFixed(3)} s | Experimental: ${D.experimental.candidate_seconds.toFixed(3)} s | Added: ${(D.experimental.added_candidate_frames/D.fps).toFixed(3)} s. UNVALIDATED; confirmed posture not assessed.`;}
function experimentalEnabled(){return !!D.experimental&&!D.reviewed&&document.getElementById('experimentalToggle').checked}
const displayedBouts=D.reviewed?D.reviewed.bouts:D.experimental?D.experimental.bouts:D.turtling?.bouts;
if(D.turtling){const t=D.turtling;document.getElementById('turtleSummary').textContent=`${t.candidate_seconds.toFixed(2)} candidate seconds · ${t.candidate_fraction_detected===null?'NA':(100*t.candidate_fraction_detected).toFixed(2)+'%'} of detected time · ${t.bout_count} bouts · longest ${t.longest_bout_seconds.toFixed(2)} s · unknown ${t.unknown_seconds.toFixed(2)} s. Confirmed overturned time: not assessed.`;if(D.reviewed)document.getElementById('turtleSummary').textContent=`Review-assisted episodes: ${D.reviewed.episode_seconds.toFixed(3)} s · original candidate time ${t.candidate_seconds.toFixed(3)} s · ${D.reviewed.bouts.length} bouts. ${D.reviewed.status==='FULL_WINDOW_POSTURE_REVIEW'?'Posture reviewed throughout this window; time outside this clip is unknown.':'Includes automatic candidates; only attributed intervals are confirmed.'}`;const menu=document.getElementById('bout');displayedBouts.forEach(b=>{const o=document.createElement('option');o.value=b.start_global_frame-D.start;o.textContent=`${b.start_global_frame}–${b.end_global_frame_inclusive} (${b.seconds.toFixed(2)} s)`;menu.append(o)});menu.onchange=()=>{if(menu.value!=='')seek(+menu.value)};const c=document.getElementById('timeline').getContext('2d');D.frames.forEach((f,i)=>{c.fillStyle=D.reviewed?.evidence[i]==='human_confirmed_overturned'?'#65dfb1':!f.location_known?'#82909d':D.experimental?.episode_mask[i]&&!f.turtling_candidate?'#c79aff':f.turtling_candidate?'#ee6572':'#203444';c.fillRect(i*1000/D.frames.length,0,1000/D.frames.length+1,26)})}

function point(x,y){const g=D.geometry;return [(x-g.crop[0])*g.content_width/g.crop[2]+g.pad_x,(y-g.crop[1])*g.content_height/g.crop[3]+g.pad_y]}
function draw(i){i=Math.max(0,Math.min(D.frames.length-1,i));slider.value=i;ctx.clearRect(0,0,1280,920);ctx.strokeStyle='#70d7df';ctx.lineWidth=2;ctx.beginPath();D.arena.forEach((p,k)=>{const q=point(...p);k?ctx.lineTo(...q):ctx.moveTo(...q)});ctx.closePath();ctx.stroke();if(document.getElementById('trails').checked){ctx.strokeStyle='#ffce56';ctx.beginPath();for(let t=Math.max(1,i-299);t<=i;t++){const a=D.frames[t-1],b=D.frames[t];if(b.step_from_previous_accepted){ctx.moveTo(...point(a.x,a.y));ctx.lineTo(...point(b.x,b.y))}}ctx.stroke()}const f=D.frames[i];const reviewed=D.reviewed?.evidence[i];const experimental=experimentalEnabled();const accumulated=experimental?experimentalCumulative[i]:cumulative[i];const state=experimental?(!f.location_known?'TRACKING UNKNOWN':D.experimental.episode_mask[i]?(D.experimental.evidence[i]==='quiet_pause_hypothesis'?'QUIET PAUSE CANDIDATE':D.experimental.evidence[i]==='onset_transition_hypothesis'?'ONSET TRANSITION CANDIDATE':'TURTLING CANDIDATE'):'No candidate flag'):reviewed==='human_confirmed_overturned'?'CONFIRMED OVERTURNED':reviewed==='human_confirmed_upright'?'CONFIRMED UPRIGHT':reviewed==='human_uncertain'?'POSTURE UNCERTAIN':!f.location_known?'TRACKING UNKNOWN':f.turtling_candidate?'TURTLING CANDIDATE':'No candidate flag';ctx.fillStyle='#101b25';ctx.fillRect(15,15,850,48);ctx.fillStyle=f.turtling_candidate?'#ff8792':'#ffffff';ctx.font='24px sans-serif';ctx.fillText(`${state} | ${D.reviewed?'episode':'candidate'} total ${accumulated.toFixed(2)} s`,25,48);if(f.location_known){ctx.fillStyle='#ffce56';ctx.beginPath();ctx.arc(...point(f.x,f.y),7,0,2*Math.PI);ctx.fill()}document.getElementById('status').textContent=`Global frame ${f.global_frame} · ${f.location_known?(f.in_wall_buffer?'wall buffer':f.in_arena?'arena interior':'outside arena'):'MISSING'}${f.rejected_jump_step?' · rejected jump into this frame':''} · ${state}${f.flailing_pause?' · flailing paused':''} · accumulated ${D.reviewed?'episode':'candidate'} time ${accumulated.toFixed(2)} s`}
function seek(i){i=Math.max(0,Math.min(D.frames.length-1,i));video.pause();video.currentTime=(i+0.1)/D.fps;draw(i)}
slider.oninput=()=>seek(+slider.value);document.getElementById('play').onclick=async()=>{try{if(video.paused)await video.play();else video.pause()}catch(e){document.getElementById('mediaMessage').textContent='Playback failed: '+e.message}};video.onloadeddata=()=>{document.getElementById('mediaMessage').textContent='Ready — press Play'};video.onplaying=()=>{document.getElementById('mediaMessage').textContent='Playing'};video.onpause=()=>{document.getElementById('mediaMessage').textContent='Paused'};video.onerror=()=>{document.getElementById('mediaMessage').textContent='Video could not load. Please reopen the local playback copy.'};document.getElementById('back').onclick=()=>seek(+slider.value-1);document.getElementById('forward').onclick=()=>seek(+slider.value+1);document.getElementById('rate').onchange=e=>video.playbackRate=+e.target.value;document.getElementById('trails').onchange=()=>draw(+slider.value);
function update(){draw(Math.floor(video.currentTime*D.fps+1e-5));requestAnimationFrame(update)}requestAnimationFrame(update);
document.getElementById('current').onclick=()=>{document.getElementById('first').value=D.start+(+slider.value);document.getElementById('last').value=D.start+(+slider.value)};
document.getElementById('add').onclick=()=>{const reviewer=document.getElementById('reviewer').value.trim(),reason=document.getElementById('reason').value.trim(),first=Number(document.getElementById('first').value),last=Number(document.getElementById('last').value);if(!reviewer||!reason||!Number.isInteger(first)||!Number.isInteger(last)||first<D.start||last>D.end||first>last){alert('Enter reviewer, reason, and a valid inclusive frame range.');return}notes.push({reviewer,reason,decision:document.getElementById('decision').value,first_global_frame:first,last_global_frame:last,created_utc:new Date().toISOString()});document.getElementById('count').textContent=notes.length+' notes'};
document.getElementById('export').onclick=()=>{const blob=new Blob([JSON.stringify({schema:'ba-review-notes-v2',label:D.label,source_sha256:D.sourceHashes,notes},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=D.label+'_review_notes.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
draw(0);
</script></html>
