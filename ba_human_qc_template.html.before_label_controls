$('turtleStart').onclick=()=>{keepDraft();drafts[run.id].turtling_pending=frame;persist();ranges()};$('turtleEnd').onclick=()=>{const d=drafts[run.id];if(d.turtling_pending==null||frame<d.turtling_pending)return message('Mark a turtling start, then an end at or after it.');(d.turtling_intervals??=[]).push([d.turtling_pending,frame]);d.turtling_pending=null;$('flags').querySelectorAll('input').forEach(x=>{if(x.value==='possible_turtling')x.checked=true});keepDraft();ranges();draw()};$('turtleClear').onclick=()=>{drafts[run.id].turtling_intervals=[];drafts[run.id].turtling_pending=null;persist();ranges();draw()};$('markStart').onclick=()=>{pending=frame;keepDraft();ranges()};$('markEnd').onclick=()=>{if(pending==null||frame<pending)return message('Choose an end at or after the marked start.');drafts[run.id].intervals.push([pending,frame]);pending=null;keepDraft();ranges()};$('clearRanges').onclick=()=>{drafts[run.id].intervals=[];pending=null;keepDraft();ranges()};$('notes').oninput=$('scope').onchange=$('reviewer').oninput=keepDraft;
$('export').onclick=()=>{keepDraft();try{const d=BAHumanQC.validate(payload(),INDEX);download('BA_human_QC_20261013.json',JSON.stringify(d,null,2),'application/json')}catch(e){message(e.message)}};$('csv').onclick=()=>{try{download('BA_human_QC_20261013.csv',BAHumanQC.csv(BAHumanQC.validate(payload(),INDEX)),'text/csv')}catch(e){message(e.message)}};
$('import').onchange=async e=>{try{const d=BAHumanQC.validate(JSON.parse(await e.target.files[0].text()),INDEX);keepDraft();let conflicts=0;for(const r of d.decisions){if(decisions[r.run_id]&&JSON.stringify(decisions[r.run_id])!==JSON.stringify(r)){history.push({kind:'import_conflict_local_kept',incoming:r,local:decisions[r.run_id]});conflicts++;continue}decisions[r.run_id]=r}history.push({kind:'import',source_export:d,exported_at:d.exported_at,at:new Date().toISOString()});persist();gallery();message('Imported decisions; '+conflicts+' conflicts retained in history with local decisions unchanged.')}catch(e){message(e.message)}};
async function init(){INDEX=await(await fetch('index.json')).json();storageKey=INDEX.id+':'+INDEX.hash;try{const stored=JSON.parse(localStorage.getItem(storageKey)||'null');if(stored){BAHumanQC.validate({strict_gate_version:'0.1.0',view_scope:'Strict track added; earlier decisions retain their original scope',schema:'ba-human-qc-v1',dataset_sha256:INDEX.hash,reviewer:stored.reviewer,decisions:Object.values(stored.decisions)},INDEX);decisions=stored.decisions;drafts=stored.drafts||{};history=stored.history||[];$('reviewer').value=stored.reviewer}}catch(e){message('Saved QC could not be restored; export a backup before proceeding.')}for(const [k,text]of Object.entries(labels)){const l=document.createElement('label'),c=document.createElement('input');c.type='checkbox';c.value=k;c.onchange=keepDraft;l.append(c,document.createTextNode(text));$('flags').append(l)}await open(INDEX.runs[0].id)}init().catch(e=>message(e.message));
