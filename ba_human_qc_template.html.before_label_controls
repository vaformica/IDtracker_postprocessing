'use strict';const $=id=>document.getElementById(id),v=$('video');let INDEX,run,data,frame,request=0,stopAt=null,pending=null;let decisions={},drafts={},history=[],storageKey;
const labels={jumps:'Jumps / wrong path',missing_gaps:'Missing / gaps',possible_turtling:'Possible turtling / flip',camera_light:'Camera / lighting',wrong_object:'Wrong object / shadow',injury:'Injury / abnormal behavior',other:'Other'};
function message(s){$('msg').textContent=s}
function persist(){try{localStorage.setItem(storageKey,JSON.stringify({decisions,drafts,history,reviewer:$('reviewer').value}));}catch(e){message('Browser storage unavailable. Download your QC JSON before closing.')}}
function snapshot(){return {errors:[...$('flags').querySelectorAll('input:checked')].map(x=>x.value),notes:$('notes').value,scope:$('scope').value,turtling_intervals:structuredClone(drafts[run.id]?.turtling_intervals||[]),turtling_pending:drafts[run.id]?.turtling_pending??null,intervals:structuredClone(drafts[run.id]?.intervals||[]),pending}}
function keepDraft(){if(!run)return;drafts[run.id]=snapshot();persist()}
function selectRows(){return INDEX.runs.filter(r=>{const d=decisions[r.id],f=$('filter').value,q=$('search').value.toLowerCase();return (!q||(r.id+' '+r.label).toLowerCase().includes(q))&&(f==='all'||f==='unreviewed'&&!d||f==='flagged'&&d&&d.status!=='usable_skim'||f==='usable_skim'&&d?.status===f)})}
function xy(ctx,a,crop,color,w,h){ctx.strokeStyle=color;ctx.lineWidth=1;ctx.beginPath();let prior=null;for(const p of a){if(p[0]==null||p[1]==null){prior=null;continue}const x=(p[0]-crop[0])/crop[2]*w,y=(p[1]-crop[1])/crop[3]*h;if(prior)ctx.lineTo(x,y);else ctx.moveTo(x,y);prior=p}ctx.stroke()}
function gallery(){const g=$('gallery');g.replaceChildren();for(const r of selectRows()){const b=document.createElement('button');b.className='card'+(run?.id===r.id?' active':'');const c=document.createElement('img');c.width=115;c.height=105;c.alt=r.id+' full-run trace, same display layers';c.src='thumbs_v2/'+r.id+'_'+(($('raw').checked?1:0)+($('pro').checked?2:0)+($('strict').checked?4:0))+'.svg';b.append(c);const name=document.createElement('b');name.textContent=r.id.toUpperCase();b.append(name);for(const t of [(decisions[r.id]?.status||'Not skimmed').replaceAll('_',' '),`${r.missing} missing · ${r.jumps} jumps`,r.label]){const s=document.createElement('small');s.textContent=t;b.append(s)}b.onclick=()=>open(r.id);g.append(b)}$('progress').textContent=Object.keys(decisions).length+' / '+INDEX.runs.length+' skimmed'}
function turtleAt(i){return (drafts[run.id]?.turtling_intervals||decisions[run.id]?.turtling_intervals||[]).some(b=>frameIn(i+run.start,b))?'#ed3d8e':data.turtling?.candidate_mask[i]?'#a32dc4':null}
function frameIn(f,b){return f>=b[0]&&f<=b[1]}
function drawTurtle(){const t=data.turtling,i=frame-run.start;const names={candidate_detected:'CANDIDATE DETECTED',no_candidate_detected:'No candidate detected — may still be turtling',not_assessed_tracking:'NOT ASSESSED: missing tracking',not_assessed_recovery:'NOT ASSESSED: initial recovery not established',not_assessed_jump_block:'NOT ASSESSED: unresolved jumps block this run'};$('turtleStatus').textContent='Turtling · '+(names[t?.state[i]]||'NOT ASSESSED: predictions unavailable');const a=shownTrack(),ctx=$('trace').getContext('2d');for(let k=1;k<a.length;k++){const color=turtleAt(k),u=a[k-1],v=a[k];if(!color||u[0]==null||v[0]==null||Math.hypot(u[0]-v[0],u[1]-v[1])>=100)continue;ctx.strokeStyle=color;ctx.lineWidth=3;ctx.beginPath();ctx.moveTo((u[0]-data.crop[0])*500/data.crop[2],(u[1]-data.crop[1])*500/data.crop[3]);ctx.lineTo((v[0]-data.crop[0])*500/data.crop[2],(v[1]-data.crop[1])*500/data.crop[3]);ctx.stroke()}ctx.lineWidth=1;const c=$('timeplot').getContext('2d');for(let k=0;k<a.length;k++){const color=turtleAt(k);if(color){c.fillStyle=color;c.fillRect(k/a.length*1100,95,Math.max(1,1100/a.length),12)}}}
function shownTrack(){return $('strict').checked&&data.strict?data.strict.analysis:data.proposed}
function drawOverlay(){
 const canvas=$('overlay'),ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);if(!data||!$('overlayOn').checked)return;
 const w=data.crop[2],h=data.crop[3];if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}
 const i=frame-run.start,point=shownTrack()[i];const changed=k=>{const a=data.raw[k],b=data.proposed[k];return (a[0]==null)!==(b[0]==null)||(a[0]!=null&&b[0]!=null&&Math.hypot(a[0]-b[0],a[1]-b[1])>.01)};
 function trail(arr,raw){for(let k=Math.max(1,i-89);k<=i;k++){const a=arr[k-1],b=arr[k];if(!a||!b||a[0]==null||b[0]==null||Math.hypot(a[0]-b[0],a[1]-b[1])>=100)continue;ctx.strokeStyle=raw?'rgba(240,240,240,.65)':turtleAt(k)|| (changed(k)||changed(k-1)?'#ff9e24':'#00e6bd');ctx.lineWidth=raw?1:2;ctx.beginPath();ctx.moveTo(a[0]-data.crop[0],a[1]-data.crop[1]);ctx.lineTo(b[0]-data.crop[0],b[1]-data.crop[1]);ctx.stroke()}}
 if($('raw').checked)trail(data.raw,true);trail(shownTrack(),false);
 if(point&&point[0]!=null){ctx.strokeStyle=turtleAt(i)||(changed(i)?'#ff9e24':'#00e6bd');ctx.lineWidth=2.5;ctx.beginPath();ctx.arc(point[0]-data.crop[0],point[1]-data.crop[1],11,0,Math.PI*2);ctx.stroke();$('overlayStatus').textContent=changed(i)?'Changed proposed position (unreviewed)':'Proposed position unchanged from raw';}
 else $('overlayStatus').textContent=data.excluded.includes(frame)?'Human-excluded frame: no position circle':data.strict?.uncertain_frames.includes(frame)?'Unresolved jump endpoint: position unknown; run movement blocked':'Tracking missing: no position circle';
}
function draw(){if(!data)return;const ctx=$('trace').getContext('2d');ctx.clearRect(0,0,500,500);if($('raw').checked)xy(ctx,data.raw,data.crop,'#a4a9ad',500,500);if($('pro').checked){xy(ctx,data.proposed,data.crop,'#008672',500,500);ctx.strokeStyle='#d8342a';ctx.beginPath();for(let i=1;i<data.proposed.length;i++){const a=data.proposed[i-1],b=data.proposed[i];if(a[0]!=null&&b[0]!=null&&Math.hypot(a[0]-b[0],a[1]-b[1])>100){ctx.moveTo((a[0]-data.crop[0])*500/data.crop[2],(a[1]-data.crop[1])*500/data.crop[3]);ctx.lineTo((b[0]-data.crop[0])*500/data.crop[2],(b[1]-data.crop[1])*500/data.crop[3])}}ctx.stroke()}if($('strict').checked&&data.strict)xy(ctx,data.strict.analysis,data.crop,'#008672',500,500);const p=shownTrack()[frame-run.start];if(p&&p[0]!=null){ctx.fillStyle='#111';ctx.beginPath();ctx.arc((p[0]-data.crop[0])*500/data.crop[2],(p[1]-data.crop[1])*500/data.crop[3],5,0,7);ctx.fill()}drawTime();drawTurtle();drawOverlay()}
function drawTime(){const ctx=$('timeplot').getContext('2d'),n=data.proposed.length;ctx.clearRect(0,0,1100,130);ctx.fillStyle='#5a727b';for(let i=1;i<n;i++){const a=data.proposed[i-1],b=data.proposed[i];if(a[0]!=null&&b[0]!=null){const d=Math.hypot(a[0]-b[0],a[1]-b[1]);ctx.fillStyle=d>100?'#d8342a':'#5a727b';ctx.fillRect(i/n*1100,110-Math.min(200,d)/2,1,Math.min(200,d)/2)}}for(const e of data.events){if(e.kind==='jump >100 px'||e.kind==='turtling candidate')continue;ctx.fillStyle=e.kind.startsWith('unresolved')?'#d8342a':e.kind==='human-excluded'?'#555555':'#ed9d35';ctx.fillRect((e.bounds[0]-run.start)/n*1100,112,Math.max(1,(e.bounds[1]-e.bounds[0]+1)/n*1100),14)}ctx.fillStyle='#111';ctx.fillRect((frame-run.start)/n*1100,0,2,130)}
function paint(f){frame=Math.max(run.start,Math.min(run.end,f));$('frame').textContent='Global frame '+frame+' / '+run.end;$('seek').value=frame;if(document.activeElement!==$('goto'))$('goto').value=frame;draw()}
function seek(f){f=Math.round(Number(f));if(!Number.isFinite(f)||!run)return;f=Math.max(run.start,Math.min(run.end,f));stopAt=null;v.pause();v.currentTime=(f-run.start+.5)/30;paint(f)}
async function play(){try{await v.play();$('mediaStatus').textContent=''}catch(e){if(e.name!=='AbortError')$('mediaStatus').textContent='Video unavailable: '+e.message}}
async function open(id){keepDraft();v.pause();stopAt=null;const token=++request;run=INDEX.runs.find(x=>x.id===id);data=null;for(const id of ['trace','overlay','timeplot']){const c=$(id);c.getContext('2d').clearRect(0,0,c.width,c.height)}$('versionNote').textContent='Loading selected run…';$('strictStatus').textContent='';$('events').replaceChildren();$('overlayStatus').textContent='Loading selected run…';$('turtleStatus').textContent='Turtling · loading / not assessed';frame=run.start;$('title').textContent=run.id.toUpperCase();$('label').textContent=run.label;$('metrics').textContent=`${run.missing} unexpected missing frames · ${run.excluded} human-excluded · ${run.jumps} jumps >100 px`;$('auto').textContent='Automatic review hints: '+(run.reasons.join(' · ')||'None; this is not approval');$('seek').min=run.start;$('seek').max=run.end;v.src=run.media;v.load();v.playbackRate=+$('speed').value;const d=drafts[id]||decisions[id]||{errors:[],notes:'',scope:'trace_skim',intervals:[]};pending=d.pending??null;drafts[id]=structuredClone(d);$('flags').querySelectorAll('input').forEach(x=>x.checked=d.errors.includes(x.value));$('notes').value=d.notes;$('scope').value=d.scope;$('saved').textContent=decisions[id]?'Saved: '+decisions[id].status+' by '+decisions[id].reviewer:'Not yet skimmed';ranges();message('');gallery();try{const response=await fetch(run.data);if(!response.ok)throw Error('Trace unavailable');const loaded=await response.json();if(token!==request)return;data=loaded;const strictResponse=await fetch('strict_v1/'+id+'.json');if(!strictResponse.ok)throw Error('Strict gate unavailable; do not use for movement analysis');const strictData=await strictResponse.json();if(token!==request)return;data.strict=strictData;try{const tr=await fetch('turtling_v1/'+id+'.json');if(!tr.ok)throw Error('unavailable');const td=await tr.json();if(token!==request)return;data.turtling=td;data.events.push(...td.bouts.map(bounds=>({kind:'turtling candidate',bounds})));}catch(e){data.turtling=null;}$('strictStatus').textContent=strictData.human_run_review_required?'MOVEMENT BLOCKED: '+strictData.jump_pairs.length+' unresolved jumps ≥100 px. Episode boundaries unknown; review whole run for inclusion/exclusion.':'Strict jump gate: no ≥100 px discontinuities. Other QC still applies.';data.events.push(...strictData.jump_pairs.map(bounds=>({kind:'unresolved jump ≥100 px',bounds})));const changedCount=data.proposed.reduce((n,b,i)=>{const a=data.raw[i];return n+Number((a[0]==null)!==(b[0]==null)||(a[0]!=null&&b[0]!=null&&Math.hypot(a[0]-b[0],a[1]-b[1])>.01))},0);$('versionNote').textContent='Version: delivered additional-100 FINAL.npz proposal · '+changedCount+' changed observations. Newer gap-recovery pilot is NOT included. Source '+data.input_sha256.slice(0,12)+'.';const notes=$('prior');notes.replaceChildren();for(const r of (data.prior_reviews||[])){const p=document.createElement('p');const d=r.decision;p.textContent=`${d.reviewer||'Reviewer'} · ${d.start}–${d.end} · video ${d.video_decision||'unscored'} / trace ${d.trace_decision||'unscored'}: ${d.notes||'(no note)'} [scope: ${d.video_scope||d.trace_scope||'original review'}]`;notes.append(p)}if(!(data.prior_reviews||[]).length)notes.textContent='No imported review notes for this run.';paint(run.start);const box=$('events');box.replaceChildren();for(const e of data.events){const b=document.createElement('button');b.textContent=e.kind+' '+e.bounds.join('–');b.onclick=()=>{seek(e.bounds[0]);excerpt()};box.append(b)}}catch(e){message(e.message)}}
function ranges(){$('turtleRanges').textContent=(drafts[run.id]?.turtling_intervals||[]).map(b=>b.join('–')).join(', ')+(drafts[run.id]?.turtling_pending!=null?' · turtling start '+drafts[run.id].turtling_pending:'');$('ranges').textContent=(drafts[run.id]?.intervals||[]).map(x=>x.join('–')).join(', ')+(pending!=null?' · open start '+pending:'')}
function navigate(delta,unreviewed=false){const list=selectRows();let i=list.findIndex(x=>x.id===run.id);for(let j=i+delta;j>=0&&j<list.length;j+=delta)if(!unreviewed||!decisions[list[j].id])return open(list[j].id);message('End of this filtered queue. Download your QC decisions.')}
function payload(){return {strict_gate_version:'0.1.0',view_scope:'Strict track added; earlier decisions retain their original scope',schema:'ba-human-qc-v1',dataset_sha256:INDEX.hash,dataset_id:INDEX.id,reviewer:$('reviewer').value.trim(),exported_at:new Date().toISOString(),scope:'Human screening and exclusion recommendations only; no source changes or posture labels',decisions:Object.values(decisions),drafts,history}}
function save(status){keepDraft();if(status==='usable_skim'&&data?.strict?.human_run_review_required)return message('Unresolved large jumps block a usable decision. Choose closer review or recommend exclusion.');if(drafts[run.id]?.turtling_pending!=null)return message('Finish or clear the open turtling interval.');if(pending!=null)return message('Finish or clear the optional open interval.');const d={...drafts[run.id],run_id:run.id,status,turtling_version:data?.turtling?.version||'NOT_ASSESSED',strict_gate_version:'0.1.0',movement_status:data?.strict?.movement_status||'NOT_ASSESSED',reviewer:$('reviewer').value.trim(),at:new Date().toISOString()};delete d.pending;try{BAHumanQC.validate({...payload(),decisions:[d]},INDEX)}catch(e){return message(e.message)}history.push({run_id:run.id,previous:decisions[run.id]||null,next:d,at:d.at});decisions[run.id]=d;delete drafts[run.id];persist();gallery();navigate(1);$('saved').textContent=decisions[run.id]?'Saved: '+decisions[run.id].status:'Not yet skimmed'}
function download(name,text,type){const u=URL.createObjectURL(new Blob([text],{type})),a=document.createElement('a');a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}
function excerpt(){const f=frame;seek(f-150);stopAt=Math.min(run.end,f+149);play()}
$('play').onclick=()=>v.paused?play():v.pause();$('excerpt').onclick=excerpt;$('full').onclick=()=>{seek(run.start);play()};$('speed').onchange=()=>v.playbackRate=+$('speed').value;$('seek').oninput=()=>seek($('seek').value);$('go').onclick=()=>seek($('goto').value);$('back').onclick=()=>seek(frame-1);$('forward').onclick=()=>seek(frame+1);
v.onloadeddata=()=>{if(run)paint(run.start)};v.onseeked=()=>{if(run)paint(run.start+Math.floor(v.currentTime*30+1e-6))};v.onerror=()=>$('mediaStatus').textContent='Video could not load. Trace decisions remain available; do not claim video review.';
function tick(t){if(!run)return;const f=run.start+Math.floor(t*30+1e-6);if(stopAt!=null&&f>=stopAt){v.pause();stopAt=null}paint(f)}if(v.requestVideoFrameCallback){const cb=(n,m)=>{tick(m.mediaTime);v.requestVideoFrameCallback(cb)};v.requestVideoFrameCallback(cb)}else v.ontimeupdate=()=>tick(v.currentTime);
$('timeplot').onclick=e=>{const r=e.currentTarget.getBoundingClientRect();seek(run.start+(e.clientX-r.left)/r.width*(run.end-run.start))};$('trace').onclick=e=>{if(!data)return;const r=e.currentTarget.getBoundingClientRect(),x=data.crop[0]+(e.clientX-r.left)/r.width*data.crop[2],y=data.crop[1]+(e.clientY-r.top)/r.height*data.crop[3];let best=Infinity,id=0;data.proposed.forEach((p,i)=>{if(p[0]==null)return;const d=Math.hypot(x-p[0],y-p[1]);if(d<best){best=d;id=i}});seek(run.start+id)};
