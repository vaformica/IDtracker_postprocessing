$('overlayOn').onchange=drawOverlay;$('strict').onchange=$('raw').onchange=$('pro').onchange=()=>{draw();gallery()};$('prev').onclick=()=>navigate(-1);$('next').onclick=()=>navigate(1);$('nextOpen').onclick=()=>navigate(1,true);$('filter').onchange=$('search').oninput=gallery;$('usable').onclick=()=>save('usable_skim');$('flag').onclick=()=>save('needs_review');$('exclude').onclick=()=>save('recommend_exclusion');
