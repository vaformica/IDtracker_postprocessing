function loadData(r){return new Promise((resolve,reject)=>{const s=document.createElement('script');window.loadRun=d=>{if(d.id!==r.id)return;resolve(d);s.remove()};s.src='runs/'+r.id+'/data.js';s.onerror=()=>reject(Error('Run data missing. Extract the entire package.'));document.body.append(s)})}
