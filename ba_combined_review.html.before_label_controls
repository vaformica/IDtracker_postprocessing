function payload(){return {review_ui_version:'1.6.0',turtling_cutoff_percent:turtlingCutoff,processing_version:'uniform-recovery-interpolation-1',view_scope:'New combined track; earlier decisions are not approvals',schema:'ba-combined-qc-v1',dataset_sha256:INDEX.hash,dataset_id:INDEX.id,reviewer:$('reviewer').value.trim(),exported_at:new Date().toISOString(),scope:'Human screening and exclusion recommendations only; no source changes or posture labels',decisions:Object.values(decisions).map(d=>({...d,turtling_summary:withCutoff(d.turtling_summary)})),drafts:Object.fromEntries(Object.entries(drafts).map(([id,d])=>[id,{...d,turtling_summary:withCutoff(d.turtling_summary)}])),history}}
function save(status){keepDraft();if(!data)return message('Wait for this run to load.');if(status==='usable_skim'&&$('rerun').checked)return message('A rerun request needs closer review; use that button to save.');if(drafts[run.id]?.turtling_pending!=null)return message('Finish or clear the open turtling interval.');if(pending!=null)return message('Finish or clear the optional open interval.');const d={...drafts[run.id],run_id:run.id,source_video:data.video,source_label:run.label,census_id:data.census_id,status,analysis_approved:status==='usable_skim',possible_flags:[...drafts[run.id].errors],turtling_version:data?.turtling?.version||'NOT_ASSESSED',strict_gate_version:'0.1.0',movement_status:data?.strict?.movement_status||'NOT_ASSESSED',automatic_jump_pairs:structuredClone(data.strict.jump_pairs||data.jump_frames.map(f=>[f-1,f])),review_does_not_clear_analysis_hold:!$('movementOverride').checked,effective_movement_status:$('movementOverride').checked?'HUMAN_OVERRIDE_USE_STRICT_TRACK':data.strict.movement_status||'NOT_ASSESSED',reviewer:$('reviewer').value.trim(),at:new Date().toISOString()};delete d.pending;try{BAHumanQC.validate({...payload(),decisions:[d]},INDEX)}catch(e){return message(e.message)}history.push({run_id:run.id,previous:decisions[run.id]||null,next:d,at:d.at});lastDecisionId=run.id;decisions[run.id]=d;delete drafts[run.id];persist();gallery();navigate(1);$('saved').textContent=decisions[run.id]?'Saved: '+decisions[run.id].status:'Not yet skimmed'}
