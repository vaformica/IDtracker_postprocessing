'use strict';const $=id=>document.getElementById(id),v=$('video');let INDEX,run,data,frame,request=0,stopAt=null,pending=null;let decisions={},drafts={},history=[],storageKey;let turtlingCutoff=15;let resumeRun=null;let lastDecisionId=null;
function coverage(){return document.querySelector('input[name=coverage]:checked').value} function setCoverage(value){document.querySelectorAll('input[name=coverage]').forEach(e=>e.checked=e.value===value)}
const labels={jumps:'Jumps / wrong path',missing_gaps:'Missing / gaps',possible_turtling:'Possible turtling / flip',camera_light:'Camera / lighting',wrong_object:'Wrong object / shadow',injury:'Injury / abnormal behavior',other:'Other'};
function message(s){$('msg').textContent=s}
function persist(){try{localStorage.setItem(storageKey,JSON.stringify({decisions,drafts,history,last_run_id:run?.id,shortcutsEnabled:$('shortcuts').checked,turtlingCutoff,reviewer:$('reviewer').value}));}catch(e){message('Browser storage unavailable. Download your QC JSON before closing.')}}
function withCutoff(summary){return summary?{...summary,cutoff_percent:turtlingCutoff,cutoff_reached:turtlingCutoff==null?null:summary.estimated_percent>turtlingCutoff}:undefined}
function currentTurtleSummary(){if(!run)return undefined;if(!data)return withCutoff(drafts[run.id]?.turtling_summary||decisions[run.id]?.turtling_summary);return BAHumanQC.turtlingSummary(run.start,run.end,drafts[run.id]?.turtling_intervals||decisions[run.id]?.turtling_intervals||[],data.turtling?.candidate_mask,data.turtling?.state,turtlingCutoff)}
function drawTurtlePercent(){const t=currentTurtleSummary();if(!t){$('turtlePercent').textContent='Estimated turtled: loading…';$('turtlePercentDetail').textContent='';$('turtleCutoffStatus').textContent='';return}const fmt=x=>x==null?'not available':x.toFixed(2)+'%';$('turtlePercent').textContent='Estimated turtled: '+fmt(t.estimated_percent);$('turtlePercentDetail').textContent='Human marked '+fmt(t.human_marked_percent)+' · automatic candidates '+fmt(t.automatic_candidate_percent)+' · '+t.combined_flagged_frames+' / '+t.denominator_frames+' frames. Automatic assessment: '+(t.automatic_assessed_frames??0)+' frames. Open bouts are not counted until an end is marked.';$('turtleCutoffStatus').textContent=t.cutoff_reached==null?'':t.cutoff_reached?' · SUGGEST REMOVAL: over cutoff':' · Not over cutoff (incomplete review may miss bouts)'}
function snapshot(){return {turtling_summary:currentTurtleSummary(),errors:[...$('flags').querySelectorAll('input:checked')].map(x=>x.value),notes:$('notes').value,scope:coverage(),rerun_idtracker:$('rerun').checked,movement_override:$('movementOverride').checked,turtling_intervals:structuredClone(drafts[run.id]?.turtling_intervals||[]),turtling_pending:drafts[run.id]?.turtling_pending??null,intervals:structuredClone(drafts[run.id]?.intervals||[]),pending}}
function keepDraft(){if(!run)return;drafts[run.id]=snapshot();persist()}
function selectRows(){return INDEX.runs.filter(r=>{const d=decisions[r.id],f=$('filter').value,q=$('search').value.toLowerCase();return (!q||(r.id+' '+r.label).toLowerCase().includes(q))&&(f==='all'||f==='unreviewed'&&!d||f==='flagged'&&d&&(d.status!=='usable_skim'||d.errors.length>0)||f==='usable_skim'&&d?.status===f)})}
function xy(ctx,a,crop,color,w,h){ctx.strokeStyle=color;ctx.lineWidth=1;ctx.beginPath();let prior=null;for(const p of a){if(p[0]==null||p[1]==null){prior=null;continue}const x=(p[0]-crop[0])/crop[2]*w,y=(p[1]-crop[1])/crop[3]*h;if(prior)ctx.lineTo(x,y);else ctx.moveTo(x,y);prior=p}ctx.stroke()}
function rowTurtle(r){const d=drafts[r.id]||decisions[r.id];return d?.turtling_summary?.estimated_percent??(100*(r.turtling_candidate_frames||0)/(r.end-r.start+1))}
function gallery(){const g=$('gallery');g.replaceChildren();for(const r of selectRows()){const b=document.createElement('button');b.className='card'+(run?.id===r.id?' active':'');const c=document.createElement('img');c.width=180;c.height=170;c.alt=r.id+' full-run trace, same display layers';c.src='runs/'+r.id+'/trace_'+(($('raw').checked?1:0)+($('pro').checked?2:0)+($('strict').checked?4:0))+'.svg';b.append(c);const name=document.createElement('b');name.textContent=r.id.toUpperCase();b.append(name);for(const t of [(decisions[r.id]?.status||'Not skimmed').replaceAll('_',' '),`${r.missing} missing · ${r.jumps} jumps`,`${rowTurtle(r).toFixed(1)}% flagged turtling${turtlingCutoff!=null&&rowTurtle(r)>turtlingCutoff?' · suggest removal':''}`,r.label]){const s=document.createElement('small');s.textContent=t;b.append(s)}for(const f of decisions[r.id]?.errors||[]){const tag=document.createElement('small');tag.className='issue chip '+f;tag.textContent=labels[f];b.append(tag)}b.onclick=()=>open(r.id);g.append(b)}$('progress').textContent=Object.keys(decisions).length+' / '+INDEX.runs.length+' skimmed'}
function turtleAt(i){return (drafts[run.id]?.turtling_intervals||decisions[run.id]?.turtling_intervals||[]).some(b=>frameIn(i+run.start,b))?'#ed3d8e':data.turtling?.candidate_mask[i]?'#a32dc4':null}
function frameIn(f,b){return f>=b[0]&&f<=b[1]}
function drawTurtle(){const t=data.turtling,i=frame-run.start;const names={candidate_detected:'CANDIDATE DETECTED',no_candidate_detected:'No candidate detected — may still be turtling',not_assessed_tracking:'NOT ASSESSED: missing tracking',not_assessed_interpolated:'NOT ASSESSED: interpolated position',not_assessed_excluded:'NOT ASSESSED: human-excluded frame',not_assessed_recovery:'NOT ASSESSED: initial recovery not established',not_assessed_jump_block:'NOT ASSESSED: unresolved jumps block this run'};$('turtleStatus').textContent='Turtling · '+(names[t?.state[i]]||'NOT ASSESSED: predictions unavailable');const a=shownTrack(),ctx=$('trace').getContext('2d');for(let k=1;k<a.length;k++){const color=turtleAt(k),u=a[k-1],v=a[k];if(!color||u[0]==null||v[0]==null||Math.hypot(u[0]-v[0],u[1]-v[1])>=100)continue;ctx.strokeStyle=color;ctx.lineWidth=3;ctx.beginPath();ctx.moveTo((u[0]-data.crop[0])*500/data.crop[2],(u[1]-data.crop[1])*500/data.crop[3]);ctx.lineTo((v[0]-data.crop[0])*500/data.crop[2],(v[1]-data.crop[1])*500/data.crop[3]);ctx.stroke()}ctx.lineWidth=1;const c=$('timeplot').getContext('2d');for(let k=0;k<a.length;k++){const color=turtleAt(k);if(color){c.fillStyle=color;c.fillRect(k/a.length*1100,95,Math.max(1,1100/a.length),12)}}}
function shownTrack(){return $('strict').checked?data.strict.analysis:$('pro').checked?data.baseline:data.raw} function methodColor(i){return data.method[i]==='interpolated'?'#e98c00':data.method[i]==='prior_recovery'?'#2583df':'#008672'}
function drawOverlay(){
 const canvas=$('overlay'),ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);if(!data||!$('overlayOn').checked)return;
 const w=data.crop[2],h=data.crop[3];if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}
 const i=frame-run.start,point=shownTrack()[i];const changed=k=>{const a=data.raw[k],b=data.proposed[k];return (a[0]==null)!==(b[0]==null)||(a[0]!=null&&b[0]!=null&&Math.hypot(a[0]-b[0],a[1]-b[1])>.01)};
 function trail(arr,raw){for(let k=Math.max(1,i-89);k<=i;k++){const a=arr[k-1],b=arr[k];if(!a||!b||a[0]==null||b[0]==null||Math.hypot(a[0]-b[0],a[1]-b[1])>=100)continue;ctx.strokeStyle=raw?'rgba(240,240,240,.65)':turtleAt(k)||methodColor(k);ctx.lineWidth=raw?1:2;ctx.beginPath();ctx.moveTo(a[0]-data.crop[0],a[1]-data.crop[1]);ctx.lineTo(b[0]-data.crop[0],b[1]-data.crop[1]);ctx.stroke()}}
 if($('raw').checked)trail(data.raw,true);trail(shownTrack(),false);
 if(point&&point[0]!=null){ctx.strokeStyle=turtleAt(i)||methodColor(i);ctx.lineWidth=2.5;ctx.beginPath();ctx.arc(point[0]-data.crop[0],point[1]-data.crop[1],11,0,Math.PI*2);ctx.stroke();$('overlayStatus').textContent=data.method[i]==='interpolated'?'INTERPOLATED position — not observed':data.method[i]==='prior_recovery'?'Image-supported recovery proposal — unreviewed':'Original position retained — unreviewed';}
 else $('overlayStatus').textContent=data.excluded.includes(frame)?'Human-excluded frame: no position circle':data.strict?.uncertain_frames.includes(frame)?'Unresolved jump endpoint: position hidden; automatic movement statistics on hold':'Tracking missing: no position circle';
}
function draw(){if(!data)return;const ctx=$('trace').getContext('2d');ctx.clearRect(0,0,500,500);if($('raw').checked)xy(ctx,data.raw,data.crop,'#a4a9ad',500,500);if($('pro').checked){xy(ctx,data.baseline,data.crop,'#2583df',500,500);ctx.strokeStyle='#d8342a';ctx.beginPath();for(let i=1;i<data.proposed.length;i++){const a=data.proposed[i-1],b=data.proposed[i];if(a[0]!=null&&b[0]!=null&&Math.hypot(a[0]-b[0],a[1]-b[1])>100){ctx.moveTo((a[0]-data.crop[0])*500/data.crop[2],(a[1]-data.crop[1])*500/data.crop[3]);ctx.lineTo((b[0]-data.crop[0])*500/data.crop[2],(b[1]-data.crop[1])*500/data.crop[3])}}ctx.stroke()}if($('strict').checked){xy(ctx,data.strict.analysis,data.crop,'#008672',500,500);for(let i=0;i<data.proposed.length;i++){let p=data.strict.analysis[i];if(p[0]==null||!['interpolated','prior_recovery'].includes(data.method[i]))continue;ctx.fillStyle=methodColor(i);ctx.fillRect((p[0]-data.crop[0])*500/data.crop[2],(p[1]-data.crop[1])*500/data.crop[3],2,2)}}const p=shownTrack()[frame-run.start];if(p&&p[0]!=null){ctx.fillStyle='#111';ctx.beginPath();ctx.arc((p[0]-data.crop[0])*500/data.crop[2],(p[1]-data.crop[1])*500/data.crop[3],5,0,7);ctx.fill()}drawTime();drawTurtle();drawOverlay()}
function drawTime(){const ctx=$('timeplot').getContext('2d'),n=data.proposed.length;ctx.clearRect(0,0,1100,130);ctx.fillStyle='#5a727b';for(let i=1;i<n;i++){const a=data.proposed[i-1],b=data.proposed[i];if(a[0]!=null&&b[0]!=null){const d=Math.hypot(a[0]-b[0],a[1]-b[1]);ctx.fillStyle=d>100?'#d8342a':'#5a727b';ctx.fillRect(i/n*1100,110-Math.min(200,d)/2,1,Math.min(200,d)/2)}}for(const e of data.events){if(e.kind.startsWith('jump')||e.kind==='turtling candidate')continue;ctx.fillStyle=e.kind.startsWith('unresolved')?'#d8342a':e.kind==='human-excluded'?'#555555':e.kind==='brightness-change candidate'?'#8b6b46':e.kind==='interpolation'?'#e98c00':'#cf4d29';ctx.fillRect((e.bounds[0]-run.start)/n*1100,112,Math.max(1,(e.bounds[1]-e.bounds[0]+1)/n*1100),14)}ctx.fillStyle='#111';ctx.fillRect((frame-run.start)/n*1100,0,2,130)}
function paint(f){frame=Math.max(run.start,Math.min(run.end,f));$('frame').textContent='Global frame '+frame+' / '+run.end;$('seek').value=frame;if(document.activeElement!==$('goto'))$('goto').value=frame;draw()}
function seek(f){f=Math.round(Number(f));if(!Number.isFinite(f)||!run)return;f=Math.max(run.start,Math.min(run.end,f));stopAt=null;v.pause();v.currentTime=(f-run.start+.5)/30;paint(f)}
