$('play').onclick=()=>v.paused?play():v.pause();$('excerpt').onclick=excerpt;$('full').onclick=()=>{seek(run.start);play()};$('speed').onchange=()=>v.playbackRate=+$('speed').value;$('seek').oninput=()=>seek($('seek').value);$('go').onclick=()=>seek($('goto').value);$('back').onclick=()=>seek(frame-1);$('forward').onclick=()=>seek(frame+1);
v.onloadeddata=()=>{if(run)paint(run.start)};v.onseeked=()=>{if(run)paint(run.start+Math.floor(v.currentTime*30+1e-6))};v.onerror=()=>$('mediaStatus').textContent='Video could not load. Trace decisions remain available; do not claim video review.';
